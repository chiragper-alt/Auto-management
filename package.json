{
  "name": "auto-management",
  "version": "1.9.16",
  "description": "Auto Management",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.chiragsolanki.automangement",
    "productName": "Auto Management",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.html",
      "main.js",
      "package.json",
      "chirag-solanki-logo.svg",
      "resources/**/*",
      "preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Auto-Management-Setup-${version}.${ext}",
      "icon": "resources/auto-management.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chiragper-alt",
        "repo": "Auto-management",
        "releaseType": "release"
      }
    ]
  }
}
